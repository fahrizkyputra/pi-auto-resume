{
  "name": "@fahrizkyputra/pi-auto-resume",
  "version": "0.4.2",
  "description": "Resume a Pi session automatically after a rate limit: waits for the real reset (also for a Claude subscription behind 9router, learned from response headers), then sends a marked continuation. Waits out 5-hour and weekly plan windows and retries dropped streams on a backoff.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "rate-limit",
    "retry",
    "resume",
    "429",
    "jcode",
    "9router",
    "claude"
  ],
  "license": "MIT",
  "author": "Fahrizky Putra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fahrizkyputra/pi-auto-resume.git"
  },
  "homepage": "https://github.com/fahrizkyputra/pi-auto-resume#readme",
  "bugs": {
    "url": "https://github.com/fahrizkyputra/pi-auto-resume/issues"
  },
  "type": "module",
  "pi": {
    "extensions": [
      "./extensions/auto-resume.ts"
    ]
  },
  "bin": {
    "pi-auto-resume": "bin/jcode.mjs"
  },
  "files": [
    "extensions",
    "bin",
    "src",
    "jcode",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node scripts/e2e-rpc.mjs && node scripts/e2e-window.mjs && node scripts/e2e-9router.mjs",
    "test:e2e:jcode": "node scripts/e2e-jcode.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
