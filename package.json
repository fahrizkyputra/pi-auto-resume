{
  "name": "@fahrizkyputra/pi-auto-resume",
  "version": "0.2.0",
  "description": "Resume a Pi session automatically after a rate limit: reads the reset hint, waits, then sends a marked continuation — no human \"continue\" needed.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "rate-limit",
    "retry",
    "resume",
    "429"
  ],
  "license": "MIT",
  "author": "Fahrizky Putra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fahrizkyputra/pi-auto-resume.git"
  },
  "homepage": "https://github.com/fahrizkyputra/pi-auto-resume#readme",
  "bugs": {
    "url": "https://github.com/fahrizkyputra/pi-auto-resume/issues"
  },
  "type": "module",
  "pi": {
    "extensions": [
      "./extensions/auto-resume.ts"
    ]
  },
  "files": [
    "extensions",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node scripts/e2e-rpc.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
